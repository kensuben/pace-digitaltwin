# Copy to deploy/.env on the host and chmod 600. Never commit the real file.
APP_IMAGE=ghcr.io/OWNER/pace-digitaltwin:sha-FULL_COMMIT_SHA
MIGRATOR_IMAGE=ghcr.io/OWNER/pace-digitaltwin:sha-FULL_COMMIT_SHA-migrator
APP_ENV=production
APP_PORT=3000
DEMO_MODE=true
POSTGRES_DB=pace_digital_twin
POSTGRES_USER=pace
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://pace:replace-with-url-encoded-secret@postgres:5432/pace_digital_twin?schema=public
